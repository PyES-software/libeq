!    -*- f90 -*-
! Note: the context of this file is case sensitive.

python module fsolver
interface
module eq ! in ../libeq/eq.f90
subroutine eq_000(c,t,b,p,ctrl,npt,ncp,neq) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(in),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
end subroutine eq_000
subroutine eq_00i(c,t,bref,p,iref,iback,charge,dha,dhb,dhp,ctrl,npt,ncp,neq) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),check(shape(c, 1) == ncp + neq,shape(c, 1) == ncp + neq),depend(neq,ncp) :: c
    double precision dimension(npt,ncp),intent(in),depend(npt) :: t
    double precision dimension(neq),intent(in) :: bref
    integer dimension(neq,ncp),intent(in),depend(neq,ncp) :: p
    double precision intent(in) :: iref
    double precision dimension(npt),intent(in),depend(npt) :: iback
    integer dimension(ncp + neq),intent(in),depend(neq,ncp) :: charge
    double precision intent(in) :: dha
    double precision intent(in) :: dhb
    double precision dimension(neq,3),intent(in),depend(neq) :: dhp
    integer intent(inout) :: ctrl
    integer, optional,intent(in),check(shape(c, 0) == npt),depend(c) :: npt=shape(c, 0)
    integer, required,intent(in),check(shape(t, 1) == ncp),depend(t) :: ncp=shape(t, 1)
    integer, required,intent(in),check(shape(bref, 0) == neq),depend(bref) :: neq=shape(bref, 0)
end subroutine eq_00i
subroutine eq_0s0(c,t,b,p,cs,ks,q,ctrl,npt,ncp,neq,nsl) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(in),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    double precision dimension(npt,nsl),intent(inout),depend(npt,nsl) :: cs
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    integer dimension(nsl,ncp),intent(in),depend(ncp) :: q
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
    integer, optional,intent(hide),depend(q) :: nsl=shape(q,0)
end subroutine eq_0s0
subroutine eq_0si(c,t,bref,p,cs,ks,q,iref,iback,charge,dha,dhb,dhp,ctrl,npt,ncp,neq,nsl) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(in),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: bref
    integer dimension(neq,ncp),intent(in) :: p
    double precision dimension(npt,nsl),intent(inout),depend(npt,nsl) :: cs
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    integer dimension(nsl,ncp),intent(in),depend(ncp) :: q
    double precision intent(in) :: iref
    double precision dimension(npt),intent(in),depend(npt) :: iback
    integer dimension(ncp + neq),intent(in),depend(neq,ncp) :: charge
    double precision intent(in) :: dha
    double precision intent(in) :: dhb
    double precision dimension(neq,3),intent(in),depend(neq) :: dhp
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
    integer, optional,intent(hide),depend(q) :: nsl=shape(q,0)
end subroutine eq_0si
subroutine eq_f00(c,t,b,p,ref,ctrl,npt,ncp,neq) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(inout),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    integer intent(in) :: ref
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
end subroutine eq_f00
subroutine eq_fs0(c,t,b,p,cs,ks,q,ref,ctrl,npt,neq,ncp,nsl) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(inout),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    double precision dimension(npt,nsl),intent(inout),depend(npt,nsl) :: cs
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    integer dimension(nsl,ncp),intent(in),depend(ncp) :: q
    integer intent(in) :: ref
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(q) :: nsl=shape(q,0)
end subroutine eq_fs0
subroutine eq_f0i(c,t,b,p,iref,iback,charge,dha,dhb,dhp,ref,ctrl,npt,ncp,neq) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(inout),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    double precision intent(in) :: iref
    double precision dimension(npt),intent(in),depend(npt) :: iback
    integer dimension(ncp + neq),intent(in),depend(neq,ncp) :: charge
    double precision intent(in) :: dha
    double precision intent(in) :: dhb
    double precision dimension(neq,3),intent(in),depend(neq) :: dhp
    integer intent(in) :: ref
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
end subroutine eq_f0i
subroutine eq_fsi(c,t,b,p,cs,ks,q,iref,iback,charge,dha,dhb,dhp,ref,ctrl,npt,neq,ncp,nsl) ! in eq.f90
    double precision dimension(npt,ncp + neq),intent(inout),depend(ncp,neq,npt) :: c
    double precision dimension(npt,ncp),intent(inout),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    double precision dimension(npt,nsl),intent(inout),depend(npt,nsl) :: cs
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    integer dimension(nsl,ncp),intent(in),depend(ncp) :: q
    double precision intent(in) :: iref
    double precision dimension(npt),intent(in),depend(npt) :: iback
    integer dimension(ncp + neq),intent(in),depend(neq,ncp) :: charge
    double precision intent(in) :: dha
    double precision intent(in) :: dhb
    double precision dimension(neq,3),intent(in),depend(neq) :: dhp
    integer intent(in) :: ref
    integer intent(inout) :: ctrl
    integer, optional,intent(hide),depend(t) :: npt=shape(t,0)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(q) :: nsl=shape(q,0)
end subroutine eq_fsi
subroutine freeze_stoich(p,fp,ref,ncp,neq) ! in eq.f90
    integer dimension(neq,ncp),intent(in) :: p
    integer dimension(neq,-1 + ncp),intent(out),depend(neq,ncp) :: fp
    integer intent(in) :: ref
    integer, optional,intent(in),check(shape(p, 1) == ncp),depend(p) :: ncp=shape(p, 1)
    integer, optional,intent(in),check(shape(p, 0) == neq),depend(p) :: neq=shape(p, 0)
end subroutine freeze_stoich
subroutine freeze_component(cref,b,fb,t,ft,p,ref,ncp,neq) ! in eq.f90
    double precision intent(in) :: cref
    double precision dimension(neq),intent(in) :: b
    double precision dimension(neq),intent(out),depend(neq) :: fb
    double precision dimension(ncp),intent(in) :: t
    double precision dimension(-1 + ncp),intent(out),depend(ncp) :: ft
    integer dimension(neq,ncp),intent(in),depend(neq,ncp) :: p
    integer intent(in) :: ref
    integer, optional,intent(in),check(shape(t, 0) == ncp),depend(t) :: ncp=shape(t, 0)
    integer, optional,intent(in),check(shape(b, 0) == neq),depend(b) :: neq=shape(b, 0)
end subroutine freeze_component
subroutine freeze_component_solid(cref,q,ks,fks,ref,ncp,nsl) ! in eq.f90
    double precision intent(in) :: cref
    integer dimension(nsl,ncp),intent(in) :: q
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    double precision dimension(nsl),intent(out),depend(nsl) :: fks
    integer intent(in) :: ref
    integer, optional,intent(in),check(shape(q, 1) == ncp),depend(q) :: ncp=shape(q, 1)
    integer, optional,intent(in),check(shape(q, 0) == nsl),depend(q) :: nsl=shape(q, 0)
end subroutine freeze_component_solid
subroutine solve_point(c,t,b,p,ctrl,is_first,ncp,neq) ! in eq.f90
    double precision dimension(ncp + neq),intent(inout),depend(neq,ncp) :: c
    double precision dimension(ncp),intent(in),depend(ncp) :: t
    double precision dimension(neq),intent(in),depend(neq) :: b
    integer dimension(neq,ncp),intent(in) :: p
    integer intent(inout) :: ctrl
    logical intent(in) :: is_first
    integer, optional,intent(hide),depend(p) :: ncp=shape(p,1)
    integer, optional,intent(hide),depend(p) :: neq=shape(p,0)
end subroutine solve_point
subroutine solve_point_solid(c,cs,t,b,p,ks,q,ctrl,is_first,neq,ncp,nsl) ! in eq.f90
    double precision dimension(ncp + neq),intent(inout),check(shape(c, 0) == ncp + neq,shape(c, 0) == ncp + neq),depend(neq,ncp) :: c
    double precision dimension(nsl),intent(inout) :: cs
    double precision dimension(ncp),intent(in) :: t
    double precision dimension(neq),intent(in) :: b
    integer dimension(neq,ncp),intent(in),depend(neq,ncp) :: p
    double precision dimension(nsl),intent(in),depend(nsl) :: ks
    integer dimension(nsl,ncp),intent(in),depend(ncp,nsl) :: q
    integer intent(inout) :: ctrl
    logical intent(in) :: is_first
    integer, required,intent(in),check(shape(b, 0) == neq),depend(b) :: neq=shape(b, 0)
    integer, required,intent(in),check(shape(t, 0) == ncp),depend(t) :: ncp=shape(t, 0)
    integer, optional,intent(in),check(shape(cs, 0) == nsl),depend(cs) :: nsl=shape(cs, 0)
end subroutine solve_point_solid
end module eq
end interface
end python module fsolver
